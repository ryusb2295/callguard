# 콜가드 백엔드 설정
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. 비워 두면 해당 기능은 "확인 불가"로 표시됩니다.

# 시연 모드: true면 키가 없거나 네트워크가 끊겨도 시연용 샘플 결과를 돌려줍니다 (결과에 "시연용" 표시)
DEMO_MODE=true

# 가족 응답을 기다리는 시간(초). 지나면 다음 연락처로 넘어갑니다. 시연은 60초 정도가 적당합니다.
ESCALATE_SECONDS=60

# 국세청 사업자등록정보 상태조회 (data.go.kr 활용신청 → 일반 인증키 Decoding 값)
NTS_SERVICE_KEY=

# Google Safe Browsing API 키 (Google Cloud 콘솔에서 무료 발급)
GOOGLE_SAFE_BROWSING_KEY=

# VirusTotal API 키 (무료 계정, 분당 4회 제한)
VIRUSTOTAL_API_KEY=

# 식품안전나라 Open API 인증키 (해외직구 위해식품 차단정보 I2715). foodsafetykorea.go.kr에서 신청
FOODSAFETY_API_KEY=

# 공정위 통신판매사업자 파일(data.go.kr에서 받은 CSV)을 넣을 경로. 없으면 신고 여부는 "확인 불가"
FTC_CSV_PATH=data/telecom_sellers.csv

# (선택) LLM 분석. OpenAI 호환 엔드포인트면 무엇이든 됩니다.
# 무료로 쓰려면 내 컴퓨터의 Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
